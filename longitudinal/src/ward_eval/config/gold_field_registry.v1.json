{
  "registry_version": "ward-gold-field-registry-1.0",
  "scope": "entire_gold_case; answer entries are matched relative to checkpoints[].answer",
  "case_entries": [
    {"pattern": "$.schema_version", "classification": "provenance_only", "reason": "Gold schema identity"},
    {"pattern": "$.gold_version", "classification": "provenance_only", "reason": "Gold release identity"},
    {"pattern": "$.status", "classification": "provenance_only", "reason": "Gold workflow state"},
    {"pattern": "$.case_id", "classification": "provenance_only", "reason": "Case identity and join key"},
    {"pattern": "$.cohort", "classification": "diagnostic", "reason": "Reporting stratum; not a headline score unit"},
    {"pattern": "$.source*", "classification": "provenance_only", "reason": "Immutable source and version provenance"},
    {"pattern": "$.case_summary*", "classification": "diagnostic", "reason": "Case-level profile and consistency checks"},
    {"pattern": "$.normalized_evidence*", "classification": "diagnostic", "reason": "Public source data used for snapshot authorization and leakage checks; content is not itself an answer key"},

    {"pattern": "$.milestone_candidates[].milestone_id", "classification": "excluded_with_reason", "reason": "Milestone targets are not exposed in the public checkpoint input and are excluded from formal Eval v1 Layer 2"},
    {"pattern": "$.milestone_candidates[].name_zh", "classification": "review_only", "reason": "Chinese clinician review view"},
    {"pattern": "$.milestone_candidates[].completion_criteria[]", "classification": "review_only", "reason": "Legacy criterion text retained for review"},
    {"pattern": "$.milestone_candidates[].partial_criteria[]", "classification": "review_only", "reason": "Legacy criterion text retained for review"},
    {"pattern": "$.milestone_candidates[].safety_invalidation_rules[]", "classification": "review_only", "reason": "Legacy criterion text retained for review"},
    {"pattern": "$.milestone_candidates[]*_en*", "classification": "diagnostic", "reason": "Milestone criteria support audit and possible future scorer revisions; Eval v1 does not score milestone edges"},
    {"pattern": "$.milestone_candidates*", "classification": "diagnostic", "reason": "Milestone applicability, status, and clinical review metadata"},

    {"pattern": "$.process_gold*", "classification": "excluded_with_reason", "reason": "Runner, trajectory, transition, and W1-W4 process scoring are outside Eval v1"},
    {"pattern": "$.checkpoints[].checkpoint_id", "classification": "provenance_only", "reason": "Checkpoint identity and join key"},
    {"pattern": "$.checkpoints[].sequence_index", "classification": "provenance_only", "reason": "Canonical order constraint"},
    {"pattern": "$.checkpoints[].question.allowed_evidence_ids[]", "classification": "guardrail", "metric": "evidence_leakage", "reason": "Checkpoint evidence authorization boundary"},
    {"pattern": "$.checkpoints[].question.future_forbidden_evidence_ids[]", "classification": "guardrail", "metric": "evidence_leakage", "reason": "Future-evidence leakage boundary"},
    {"pattern": "$.checkpoints[].question*", "classification": "provenance_only", "reason": "Public checkpoint input, hashes, and evaluation-target declaration"},
    {"pattern": "$.checkpoints[].model_preannotation*", "classification": "review_only", "reason": "Audit fixture only; never evaluator-facing Gold"},
    {"pattern": "$.checkpoints[].review*", "classification": "provenance_only", "reason": "Clinical review provenance"},
    {"pattern": "$.checkpoints[].*provenance*", "classification": "provenance_only", "reason": "Generation and review provenance"},
    {"pattern": "$.checkpoints[].answer_finalization_transform*", "classification": "provenance_only", "reason": "Finalization transform audit trail"},
    {"pattern": "$.checkpoints[].legacy_question_ids*", "classification": "provenance_only", "reason": "Legacy identity mapping"},
    {"pattern": "$.checkpoints[].requires_mandatory_secondary_review", "classification": "provenance_only", "reason": "Review workflow metadata"},
    {"pattern": "$.checkpoints[].secondary_selected", "classification": "provenance_only", "reason": "Review workflow metadata"},
    {"pattern": "$.checkpoints[].secondary_selection_reasons*", "classification": "provenance_only", "reason": "Review workflow metadata"},
    {"pattern": "$.checkpoints[].selection_reasons*", "classification": "provenance_only", "reason": "Checkpoint selection provenance"},
    {"pattern": "$.checkpoints[].source_process_reference*", "classification": "excluded_with_reason", "reason": "Process/trajectory source is outside Eval v1"},
    {"pattern": "$.checkpoints[]*", "classification": "provenance_only", "reason": "Remaining checkpoint metadata not consumed by Eval v1"},

    {"pattern": "$.clinical_review*", "classification": "provenance_only", "reason": "Clinical review provenance and signatures"},
    {"pattern": "$.legacy_clinical_review_migration*", "classification": "provenance_only", "reason": "Legacy review migration audit trail"},
    {"pattern": "$.model_preannotation_status", "classification": "provenance_only", "reason": "Preannotation workflow state"},
    {"pattern": "$.model_preannotation_version", "classification": "provenance_only", "reason": "Preannotation version"},
    {"pattern": "$.review_provenance_v0_3*", "classification": "provenance_only", "reason": "Release review provenance"}
  ],
  "entries": [
    {"pattern": "$.answer_status", "classification": "provenance_only", "reason": "Workflow state, not model clinical content"},

    {"pattern": "$.layer1_evidence", "classification": "official_score", "metric": "layer1_evidence", "reason": "Explicit empty evidence set"},
    {"pattern": "$.layer1_evidence[].evidence_id", "classification": "official_score", "metric": "layer1_evidence"},
    {"pattern": "$.layer1_evidence[].role", "classification": "official_score", "metric": "layer1_evidence"},
    {"pattern": "$.layer1_evidence[].interpretation_en", "classification": "diagnostic", "reason": "Semantic explanation retained for audit; headline unit is evidence ID plus role"},
    {"pattern": "$.layer1_evidence[].interpretation_zh", "classification": "review_only", "reason": "Chinese clinician review view"},
    {"pattern": "$.layer1_evidence[].review_status", "classification": "provenance_only", "reason": "Review workflow metadata"},

    {"pattern": "$.layer2_utilization_links[].evidence_id", "classification": "official_score", "metric": "layer2_utilization"},
    {"pattern": "$.layer2_utilization_links", "classification": "official_score", "metric": "layer2_utilization", "reason": "Explicit empty utilization set"},
    {"pattern": "$.layer2_utilization_links[].claim_ids", "classification": "official_score", "metric": "layer2_utilization", "reason": "Explicit empty edge set"},
    {"pattern": "$.layer2_utilization_links[].claim_ids[]", "classification": "official_score", "metric": "layer2_utilization"},
    {"pattern": "$.layer2_utilization_links[].state_ids", "classification": "official_score", "metric": "layer2_utilization", "reason": "Explicit empty edge set"},
    {"pattern": "$.layer2_utilization_links[].state_ids[]", "classification": "official_score", "metric": "layer2_utilization"},
    {"pattern": "$.layer2_utilization_links[].action_ids", "classification": "official_score", "metric": "layer2_utilization", "reason": "Explicit empty edge set"},
    {"pattern": "$.layer2_utilization_links[].action_ids[]", "classification": "official_score", "metric": "layer2_utilization"},
    {"pattern": "$.layer2_utilization_links[].milestone_ids", "classification": "excluded_with_reason", "reason": "Milestone targets are not public at checkpoint time and are excluded from formal Eval v1 Layer 2"},
    {"pattern": "$.layer2_utilization_links[].milestone_ids[]", "classification": "excluded_with_reason", "reason": "Milestone targets are not public at checkpoint time and are excluded from formal Eval v1 Layer 2"},
    {"pattern": "$.layer2_utilization_links[].expected_outcome", "classification": "diagnostic", "reason": "Narrative outcome is retained for audit; link edges are the v1 headline unit"},
    {"pattern": "$.layer2_utilization_links[].state_effects*", "classification": "diagnostic", "reason": "State-effect narrative is covered by Layer 4 and retained for audit"},

    {"pattern": "$.layer3_claims[].canonical_en", "classification": "official_score", "metric": "layer3_claims"},
    {"pattern": "$.layer3_claims[].acceptable_aliases_en[]", "classification": "official_score", "metric": "layer3_claims"},
    {"pattern": "$.layer3_claims[].status", "classification": "official_score", "metric": "layer3_claim_status"},
    {"pattern": "$.layer3_claims[].supporting_evidence_ids[]", "classification": "official_score", "metric": "layer3_evidence_links"},
    {"pattern": "$.layer3_claims[].linked_evidence_ids[]", "classification": "official_score", "metric": "layer3_evidence_links"},
    {"pattern": "$.layer3_claims[].unacceptable_confusions[]", "classification": "guardrail", "metric": "claim_contradiction"},
    {"pattern": "$.layer3_claims[].canonical_zh", "classification": "review_only", "reason": "Chinese clinician review view"},
    {"pattern": "$.layer3_claims[].claim_id", "classification": "provenance_only", "reason": "Gold-local identity used after semantic matching"},
    {"pattern": "$.layer3_claims[]*", "classification": "diagnostic", "reason": "Claim linkage, timing, and exemption metadata retained for audit"},

    {"pattern": "$.layer4_state.*[].canonical_en", "classification": "official_score", "metric": "layer4_state"},
    {"pattern": "$.layer4_state.*.canonical_en", "classification": "official_score", "metric": "layer4_state"},
    {"pattern": "$.layer4_state.*[].canonical_zh", "classification": "review_only", "reason": "Chinese clinician review view"},
    {"pattern": "$.layer4_state.*.canonical_zh", "classification": "review_only", "reason": "Chinese clinician review view"},
    {"pattern": "$.layer4_state.*[].status", "classification": "official_score", "metric": "layer4_state_status"},
    {"pattern": "$.layer4_state.*.status", "classification": "official_score", "metric": "layer4_state_status"},
    {"pattern": "$.layer4_state.*[].linked_evidence_ids[]", "classification": "official_score", "metric": "layer4_evidence_links"},
    {"pattern": "$.layer4_state.*.linked_evidence_ids[]", "classification": "official_score", "metric": "layer4_evidence_links"},
    {"pattern": "$.layer4_state.previous_checkpoint_id", "classification": "diagnostic", "reason": "Checkpoint graph consistency"},
    {"pattern": "$.layer4_state*", "classification": "diagnostic", "reason": "State IDs, source hashes, linkage exemptions, and source attributes retained for audit"},

    {"pattern": "$.layer5_actions[].canonical_action_en", "classification": "official_score", "metric": "layer5_actions"},
    {"pattern": "$.layer5_actions[].acceptable_aliases_en[]", "classification": "official_score", "metric": "layer5_actions"},
    {"pattern": "$.layer5_actions[].category", "classification": "official_score", "metric": "layer5_category"},
    {"pattern": "$.layer5_actions[].action_scope", "classification": "official_score", "metric": "layer5_scope"},
    {"pattern": "$.layer5_actions[].critical_omission_if_missing", "classification": "guardrail", "metric": "critical_action_omission"},
    {"pattern": "$.layer5_actions[].linked_evidence_ids[]", "classification": "official_score", "metric": "layer5_evidence_links"},
    {"pattern": "$.layer5_actions[].canonical_prohibited_action_en", "classification": "guardrail", "metric": "harmful_action"},
    {"pattern": "$.layer5_actions[].canonical_action_zh", "classification": "review_only", "reason": "Chinese clinician review view"},
    {"pattern": "$.layer5_actions[].omission_rationale_zh", "classification": "review_only", "reason": "Chinese clinician review view"},
    {"pattern": "$.layer5_actions[].canonical_prohibited_action_zh", "classification": "review_only", "reason": "Chinese clinician review view"},
    {"pattern": "$.layer5_actions[]*", "classification": "diagnostic", "reason": "Action attributes and linkage metadata are retained; the reference provides explicit *_en fields"},

    {"pattern": "$.safety.hard_failure_rules[]", "classification": "guardrail", "metric": "safety"},
    {"pattern": "$.safety.critical_omission_rules[]", "classification": "guardrail", "metric": "safety"},
    {"pattern": "$.safety.preliminary_risk_triggers[]", "classification": "guardrail", "metric": "safety"},
    {"pattern": "$.safety.labels[]", "classification": "diagnostic", "reason": "Controlled labels retained alongside rule coverage"},
    {"pattern": "$.safety*", "classification": "diagnostic", "reason": "Empty safety containers are explicitly classified"},

    {"pattern": "$.stopping.decision", "classification": "official_score", "metric": "stopping_decision"},
    {"pattern": "$.stopping.remaining_blockers[]", "classification": "official_score", "metric": "stopping_blockers"},
    {"pattern": "$.stopping.rationale_en", "classification": "diagnostic", "reason": "Rationale support is a Judge diagnostic in v1"},
    {"pattern": "$.stopping.rationale_zh", "classification": "review_only", "reason": "Chinese clinician review view"},
    {"pattern": "$.stopping.pending_results_allowed_for_follow_up[]", "classification": "diagnostic", "reason": "excluded_with_reason: mixed boolean/string Gold values are not projected or scored; complete stopping-safety scoring is deferred"},
    {"pattern": "$.stopping*", "classification": "diagnostic", "reason": "Stopping metadata retained for audit"}
  ]
}
