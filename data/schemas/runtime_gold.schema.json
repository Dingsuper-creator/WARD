{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "$id": "urn:ward:runtime-gold:1",
  "required": [
    "schema_version",
    "case_id",
    "checkpoints",
    "normalized_evidence",
    "process_gold",
    "milestone_candidates"
  ],
  "properties": {
    "schema_version": {
      "const": "ward-runtime-gold-1.0"
    },
    "case_id": {
      "type": "string",
      "pattern": "^ward_[0-9]{3}$"
    },
    "normalized_evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "evidence_id",
          "record_kind",
          "raw_content",
          "title"
        ],
        "properties": {
          "evidence_id": {
            "type": "string",
            "minLength": 1
          },
          "raw_content": {
            "type": "string"
          },
          "title": {
            "type": "string"
          }
        }
      }
    },
    "checkpoints": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "checkpoint_id",
          "sequence_index",
          "question",
          "answer"
        ],
        "properties": {
          "checkpoint_id": {
            "type": "string"
          },
          "sequence_index": {
            "type": "integer"
          },
          "question": {
            "type": "object",
            "required": [
              "public_snapshot",
              "public_snapshot_sha256",
              "allowed_evidence_ids",
              "future_forbidden_evidence_ids"
            ]
          },
          "answer": {
            "type": "object",
            "required": [
              "layer1_evidence",
              "layer2_utilization_links",
              "layer3_claims",
              "layer4_state",
              "layer5_actions",
              "safety",
              "stopping"
            ]
          }
        }
      }
    },
    "process_gold": {
      "type": "object",
      "required": [
        "transitions"
      ]
    },
    "milestone_candidates": {
      "type": "array"
    }
  }
}
